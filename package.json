{
  "name": "ascendproperties-lk",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "db:local": "wrangler d1 migrations apply ascend-db --local && wrangler d1 execute ascend-db --local --file=seed.sql",
    "db:remote": "wrangler d1 migrations apply ascend-db --remote",
    "deploy": "astro build && wrangler deploy",
    "test": "node --test tests/"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.4.1",
    "@astrojs/react": "^7.1.0",
    "astro": "^7.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261019.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^7.0.2",
    "wrangler": "^4.151.2"
  }
}
