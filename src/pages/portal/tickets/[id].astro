---
import Base from '../../../layouts/Base.astro';
import { all, one } from '../../../lib/db';
import { dateFmt } from '../../../lib/util';
const user = Astro.locals.user!;
const t: any = await one('SELECT * FROM tickets WHERE id=? AND user_id=?', Astro.params.id, user.id);
if (!t) return new Response('Not found', { status: 404 });
const msgs = await all('SELECT * FROM ticket_messages WHERE ticket_id=? ORDER BY id', t.id);
---
<Base title={t.subject}>
  <div class="wrap stack" style="max-width:760px;padding-top:36px">
    <a href="/portal" class="muted">← Back to portal</a>
    <h1 style="font-size:28px">{t.subject} <span class={`badge ${t.status === 'open' ? 'warn' : 'gray'}`}>{t.status}</span></h1>
    {msgs.map((m) => <div class="panel" style={m.author_role === 'admin' ? 'background:var(--blue-l)' : ''}><div class="muted" style="font-size:12px;font-weight:600;margin-bottom:6px">{m.author_role === 'admin' ? 'Ascend team' : 'You'} · {dateFmt(m.created_at)}</div><p style="margin:0;white-space:pre-line">{m.body}</p></div>)}
    <form class="panel stack" method="post" action="/api/ticket"><input type="hidden" name="ticket_id" value={t.id} />
      <label class="field">Reply<textarea name="body" required maxlength="3000"></textarea></label><button class="btn" style="align-self:flex-start">Send</button></form>
  </div>
</Base>
