---
import Base from '../../layouts/Base.astro';
import ListingCard from '../../components/ListingCard.astro';
import LoanCalc from '../../components/LoanCalc';
import Turnstile from '../../components/Turnstile.astro';
import { bySlug } from '../../lib/listings';
import { all } from '../../lib/db';
import { arr, lkr, mediaUrl, monthly, TYPES } from '../../lib/util';

const l: any = await bySlug(Astro.params.slug!);
if (!l) return new Response('Not found', { status: 404 });
const images = [l.cover, ...arr(l.images)].filter(Boolean).filter((v, i, a) => a.indexOf(v) === i);
const facilities = arr(l.facilities);
const related = await all('SELECT * FROM listings WHERE type=? AND status=\'available\' AND id<>? ORDER BY (district=?) DESC, published_at DESC LIMIT 4', l.type, l.id, l.district);
const sent = Astro.url.searchParams.get('sent'), err = Astro.url.searchParams.get('err');
const down = l.down_payment_pct ? Math.round(l.price * l.down_payment_pct / 100) : 0;
const ld = { '@context': 'https://schema.org', '@type': 'Product', name: l.title, description: (l.description ?? '').slice(0, 300), image: images.map((i) => new URL(mediaUrl(i), Astro.url).href), offers: { '@type': 'Offer', priceCurrency: 'LKR', price: l.price, availability: l.status === 'sold' ? 'https://schema.org/SoldOut' : 'https://schema.org/InStock' } };
const hero = images[0] ? `background-image:linear-gradient(rgba(15,47,122,.25),rgba(15,47,122,.8)),url(${mediaUrl(images[0])})` : '';
---
<Base title={l.title} description={(l.description ?? '').slice(0, 155)}>
  <script type="application/ld+json" set:html={JSON.stringify(ld).replace(/</g, '\\u003c')} />
  <section class="hero" style={`padding:140px 0 40px;${hero}`}>
    <div class="wrap">
      <span class="eyebrow" style="color:#9DBBFF">{TYPES[l.type as keyof typeof TYPES]}{l.category ? ` · ${l.category}` : ''}</span>
      <h1 style="font-size:clamp(30px,4.5vw,48px);margin-top:8px">{l.title}</h1>
      <p style="margin:8px 0 0">{[l.city, l.district].filter(Boolean).join(', ')}</p>
    </div>
  </section>
  <div class="wrap" style="display:flex;flex-wrap:wrap;gap:40px;padding-top:40px;align-items:flex-start">
    <main class="stack" style="flex:1 1 640px;min-width:0;gap:40px">
      {images.length > 1 && <div class="grid g3" style="gap:12px">{images.slice(1, 7).map((i) => <a href={mediaUrl(i)} target="_blank" rel="noopener"><img src={mediaUrl(i)} alt="" loading="lazy" style="width:100%;aspect-ratio:4/3;object-fit:cover;border-radius:10px" /></a>)}</div>}
      {l.description && <section><h2 style="font-size:26px;margin-bottom:12px">About this property</h2><p style="white-space:pre-line;line-height:1.7;margin:0">{l.description}</p></section>}
      {l.down_payment_pct && l.months && <section><h2 style="font-size:26px;margin-bottom:16px">Payment plan</h2><div class="grid g3" style="gap:16px">
        <div class="panel"><span class="muted" style="font-size:12px;font-weight:600">Down payment</span><h3 style="font-size:22px">{l.down_payment_pct}%</h3><span class="muted">LKR {lkr(down)}</span></div>
        <div class="panel"><span class="muted" style="font-size:12px;font-weight:600">Instalments</span><h3 style="font-size:22px">{l.months} months</h3></div>
        <div class="panel"><span class="muted" style="font-size:12px;font-weight:600">Per month</span><h3 style="font-size:22px">LKR {lkr(Math.round((l.price - down) / l.months))}</h3></div></div></section>}
      {facilities.length > 0 && <section><h2 style="font-size:26px;margin-bottom:16px">Facilities</h2><div class="row">{facilities.map((f) => <span class="pill">{f}</span>)}</div></section>}
      {l.map_url && /^https:\/\/(www\.)?google\.[a-z.]+\/maps\/embed/.test(l.map_url) && <section><h2 style="font-size:26px;margin-bottom:16px">Location</h2><iframe src={l.map_url} title="Map" loading="lazy" style="width:100%;height:340px;border:0;border-radius:14px" referrerpolicy="no-referrer-when-downgrade"></iframe></section>}
      <LoanCalc client:visible price={l.price} />
    </main>
    <aside class="stack" style="flex:0 0 360px;position:sticky;top:96px">
      <div class="panel stack" style="box-shadow:0 6px 24px rgba(31,36,48,.08)">
        <div><span class="muted" style="font-size:12px;font-weight:600">Price from</span><h2 style="font-size:32px;color:var(--blue-d)">LKR {lkr(l.price)}</h2>{l.price_label && <span class="muted" style="font-size:13px">{l.price_label}</span>}</div>
        {sent && <div class="notice" role="status">Thank you! We'll call you back shortly.</div>}
        {err && <div class="notice err" role="alert">Could not send. Check your details and try again.</div>}
        {l.status === 'sold' ? <p class="notice">This project is sold out. <a href="/contact" style="text-decoration:underline">Ask about similar ones</a>.</p> : (
        <form method="post" action="/api/inquiry" class="stack" style="gap:12px">
          <input type="hidden" name="listing_id" value={l.id} /><input type="hidden" name="back" value={`/listing/${l.slug}`} />
          <input name="website" tabindex="-1" autocomplete="off" aria-hidden="true" style="position:absolute;left:-9999px" />
          <label class="field">Name<input name="name" required maxlength="100" autocomplete="name" /></label>
          <label class="field">Phone<input name="phone" required type="tel" maxlength="30" autocomplete="tel" /></label>
          <label class="field">Email (optional)<input name="email" type="email" maxlength="120" autocomplete="email" /></label>
          <label class="field">Message<textarea name="message" rows="3" maxlength="1000"></textarea></label>
          <Turnstile />
          <button class="btn">Send inquiry</button>
        </form>)}
        {l.brochure && <a class="btn ghost" href={mediaUrl(l.brochure)} target="_blank" rel="noopener">Download brochure</a>}
      </div>
    </aside>
  </div>
  {related.length > 0 && <div class="wrap" style="padding-top:64px"><h2 style="font-size:26px;margin-bottom:20px">We also recommend</h2><div class="grid g4">{related.map((r) => <ListingCard l={r} />)}</div></div>}
</Base>
