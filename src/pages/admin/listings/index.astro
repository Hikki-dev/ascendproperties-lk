---
import Admin from '../../../layouts/Admin.astro';
import { all } from '../../../lib/db';
import { lkr, mediaUrl, TYPES } from '../../../lib/util';
const rows = await all('SELECT * FROM listings ORDER BY id DESC');
const tone: Record<string, string> = { available: 'ok', draft: 'gray', sold: 'warn' };
---
<Admin title="Listings">
  <div class="row between"><h1 style="font-size:30px">Listings</h1><a class="btn" href="/admin/listings/new">+ Add listing</a></div>
  <div class="panel scroll-x"><table class="table cards"><thead><tr><th></th><th>Title</th><th>Type</th><th>District</th><th>Price</th><th>Status</th><th></th></tr></thead><tbody>
    {rows.map((l) => <tr>
      <td class="thumbcell"><div style={`width:56px;height:42px;border-radius:6px;background:#DDE3EE center/cover;${l.cover ? `background-image:url(${mediaUrl(l.cover)})` : ''}`}></div></td>
      <td><a href={`/admin/listings/${l.id}`} style="font-weight:600;color:var(--blue-d)">{l.title}</a>{l.featured ? ' ★' : ''}</td>
      <td data-l="Type">{TYPES[l.type as keyof typeof TYPES]}</td><td data-l="District">{l.district}</td><td data-l="Price">LKR {lkr(l.price)}</td>
      <td data-l="Status"><span class={`badge ${tone[l.status]}`}>{({ available: 'Live', draft: 'Hidden', sold: 'Sold out' } as any)[l.status]}</span></td>
      <td class="row"><a class="btn ghost sm" href={`/admin/listings/${l.id}`}>Edit</a>{l.status !== 'draft' && <a class="btn ghost sm" href={`/listing/${l.slug}`} target="_blank" rel="noopener">View</a>}</td></tr>)}
    {rows.length === 0 && <tr><td colspan="7" class="muted">No listings yet.</td></tr>}
  </tbody></table></div>
</Admin>
