---
import Admin from '../../../layouts/Admin.astro';
import { all } from '../../../lib/db';
import { lkr } from '../../../lib/util';
const rows = await all(`SELECT u.*, (SELECT COUNT(*) FROM purchases p WHERE p.user_id=u.id) np,
  (SELECT COALESCE(SUM(total),0) FROM purchases p WHERE p.user_id=u.id) total,
  (SELECT COALESCE(SUM(y.amount),0) FROM payments y JOIN purchases p ON p.id=y.purchase_id WHERE p.user_id=u.id) paid
  FROM users u WHERE role='customer' ORDER BY id DESC`);
const err = Astro.url.searchParams.get('err');
---
<Admin title="Customers">
  <h1 style="font-size:30px">Customers & purchases</h1>
  <div class="panel scroll-x"><table class="table"><thead><tr><th>Customer</th><th>Phone</th><th>Purchases</th><th>Paid / Total</th></tr></thead><tbody>
    {rows.map((u) => <tr><td><a href={`/admin/customers/${u.id}`} style="font-weight:600;color:var(--blue-d)">{u.name}</a><br /><span class="muted">{u.email}</span></td><td>{u.phone}</td><td>{u.np}</td><td>LKR {lkr(u.paid)} / {lkr(u.total)}</td></tr>)}
    {rows.length === 0 && <tr><td colspan="4" class="muted">No customers yet.</td></tr>}
  </tbody></table></div>
  <form class="panel stack" method="post" action="/admin/api/aftersales"><h2 style="font-size:18px">Add a customer account</h2><input type="hidden" name="op" value="create_customer" />
    {err && <div class="notice err" role="alert">Email already used, or password shorter than 8 characters.</div>}
    <div class="grid g2" style="gap:12px"><label class="field">Name<input name="name" required /></label><label class="field">Phone<input name="phone" type="tel" /></label>
      <label class="field">Email (their login)<input name="email" type="email" required /></label><label class="field">Temporary password (min 8)<input name="password" minlength="8" required autocomplete="off" /></label></div>
    <button class="btn" style="align-self:flex-start">Create account</button>
  </form>
</Admin>
