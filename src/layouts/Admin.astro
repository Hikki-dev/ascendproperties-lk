---
import '../styles/global.css';
interface Props { title: string; }
const { title } = Astro.props;
const p = Astro.url.pathname;
const groups: [string, [string, string][]][] = [
  ['Website', [['/admin', 'Dashboard'], ['/admin/listings', 'Listings'], ['/admin/banners', 'Banners & ads']]],
  ['Leads', [['/admin/inquiries', 'Inquiries'], ['/admin/sellers', 'Sell-your-land leads']]],
  ['After-sales', [['/admin/customers', 'Customers & purchases'], ['/admin/tickets', 'Support tickets']]],
];
const cur = (h: string) => (h === '/admin' ? p === '/admin' : p.startsWith(h));
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" /><meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta name="robots" content="noindex" />
  <title>{title} | Admin</title>
  <link rel="icon" type="image/png" href="/mark.png" />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Plus+Jakarta+Sans:wght@700;800&display=swap" rel="stylesheet" />
</head>
<body>
  <div class="admin">
    <aside>
      <b>Ascend Admin</b>
      {groups.map(([g, items]) => (<><h4>{g}</h4>{items.map(([h, l]) => <a href={h} aria-current={cur(h) ? 'page' : undefined}>{l}</a>)}</>))}
      <h4>Account</h4>
      <a href="/" target="_blank" rel="noopener">View site ↗</a>
      <form method="post" action="/api/logout"><button class="btn ghost sm" style="margin:8px 12px">Sign out</button></form>
    </aside>
    <main>
      <slot />
    </main>
  </div>
</body>
</html>
