---
import { lkr, mediaUrl, arr } from '../lib/util';
import { firstName, waLink } from '../lib/settings';
const { l, s } = Astro.props;
const bg = l.cover ? `background-image:url(${mediaUrl(l.cover)})` : '';
const isNew = l.published_at && Date.now() - new Date(l.published_at.replace(' ', 'T') + 'Z').getTime() < 7 * 864e5;
const fac = arr(l.facilities);
const facts = [l.extent, fac.includes('Clear title') && 'Clear deed', fac.includes('Electricity') && fac.includes('Water') ? 'Electricity and water' : fac.includes('Electricity') ? 'Electricity' : fac.includes('Water') ? 'Water' : ''].filter(Boolean).join(' · ');
const monthly = l.down_payment_pct && l.months ? Math.round((l.price * (100 - l.down_payment_pct) / 100) / l.months) : 0;
const where = [l.city, l.district].filter(Boolean).join(', ') + (l.nearby ? ` · ${l.nearby}` : '');
---
<div class="lrow">
  <a class="ph" href={`/listing/${l.slug}`} style={bg} role="img" aria-label={l.title}>{l.status === 'sold' ? <span class="label sold">Sold out</span> : isNew && <span class="label">New</span>}</a>
  <a href={`/listing/${l.slug}`}>
    <h3>{l.title}</h3><p class="where">{where}</p>
    <p class="price" style="margin-top:10px"><b>LKR {lkr(l.price)}</b> {l.price_label && <span>{l.price_label}</span>}</p>
    {facts && <p class="facts">{facts}</p>}
    {monthly > 0 && <p class="facts">Pay in instalments: from <b>LKR {lkr(monthly)}</b> a month</p>}
  </a>
  <div class="acts">
    <a class="wa" href={waLink(s, `Hi ${firstName(s)}, I'm interested in ${l.title} (LKR ${lkr(l.price)}${l.price_label ? ' ' + l.price_label : ''}).`)} target="_blank" rel="noopener">Ask on WhatsApp</a>
    <a class="btn ghost" href={`/listing/${l.slug}`}>View details</a>
  </div>
</div>
