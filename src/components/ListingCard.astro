---
import { lkr, mediaUrl } from '../lib/util';
const { l } = Astro.props;
const bg = l.cover ? `background-image:url(${mediaUrl(l.cover)})` : '';
const isNew = l.published_at && Date.now() - new Date(l.published_at.replace(' ', 'T') + 'Z').getTime() < 7 * 864e5;
---
<a class="card" href={`/listing/${l.slug}`}>
  <div class="ph" style={bg} role="img" aria-label={l.title}>
    {l.status === 'sold' ? <span class="tag sold">SOLD OUT</span> : isNew && <span class="tag">NEW</span>}
  </div>
  <div class="body">
    <h3>{l.title}</h3>
    <p class="muted" style="margin:4px 0 10px;font-size:14px">{[l.city, l.district].filter(Boolean).join(', ')}</p>
    <p class="price" style="margin:0">LKR {lkr(l.price)} {l.price_label && <small>{l.price_label}</small>}</p>
  </div>
</a>
